# Copy to .env and change what you need. Every value is optional.

# 127.0.0.1 = this machine only, 0.0.0.0 = every network card (Docker sets 0.0.0.0 inside the container)
HOST=127.0.0.1
PORT=8089

# When set, every /api/* request needs the header  X-API-Key: <value>
API_KEY=

# Version used when a request does not give one
DEFAULT_VERSION=6.3.4

# Folder with one sub folder per version
GROUPERS_DIR=./groupers

# Requests that may wait at the same time (more get HTTP 503)
MAX_QUEUE=200

# Cases in one POST /api/v1/group/batch
MAX_BATCH=5000

# Records in one .dbf file sent to POST /api/v1/group/file (the file may be 50 MB at most)
MAX_FILE_RECORDS=100000

# off = no web page at /  (the API and /docs stay)
WEB_UI=on

# fatal, error, warn, info, debug
LOG_LEVEL=info

# docker compose only: address and port published on the host
DRG_BIND=127.0.0.1
DRG_PORT=8089
# docker compose only: image to run (a released tag, or the one you build with --build)
DRG_IMAGE=ghcr.io/somprasongd/thai-drg-grouper:1
